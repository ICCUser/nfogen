      {"piece_size": 16777216}
    ],
    "upload": {
      "category_id": 1,
      "subcategory_id": {
        "movie": 6, "movie:anime": 1, "movie:documentaire": 4,
        "series": 7, "series:anime": 2, "series:documentaire": 4
      },
      "language_option_id": 1,
      "language_values": {"VFF": 2, "MULTI.VFF": 4, "VO": 1, "VOSTFR": 8},
      "quality_option_id": 2,
      "quality_values": {
        "BluRay.HDLight": 413, "BluRay": 11, "BluRay.REMUX": 12,
