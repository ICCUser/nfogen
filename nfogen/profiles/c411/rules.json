        "BDRemux": "BluRay.REMUX",
        "BluRay": "BluRay",
        "HDTV": "HDTV",
        "DVDRip": "DVDRip",
        "DSNP": "WEB.DSNP",
        "NF": "WEB.NF",
        "AMZN": "WEB.AMZN"
      },
      "video_codec_aliases": {
        "x264": "x264",
        "x265": "x265",
        "H.264": "h.264",
        "H264": "h264",
        "H.265": "h.265",
