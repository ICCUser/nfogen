{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nfogen rules.json",
  "description": "Schema generique d'un fichier de regles de profil nfogen. Chaque cle de premier niveau DOIT etre soit un nom de categorie de media connu du coeur (video/audio/game/ebook/print3d), soit 'tracker' (reglages propres au tracker, pas a une categorie) -- une cle inconnue (typo, futur nom non encore supporte...) est REJETEE ici plutot qu'ignoree silencieusement.",
  "type": "object",
  "propertyNames": {
    "enum": ["video", "audio", "game", "ebook", "print3d", "tracker"]
  },
  "patternProperties": {
    "^(video|audio|game|ebook|print3d)$": { "$ref": "#/$defs/category" },
    "^tracker$": { "$ref": "#/$defs/tracker" }
  },
  "additionalProperties": false,
  "$defs": {
    "tracker": {
      "type": "object",
      "description": "Reglages propres a CE tracker, pas a une categorie de media (voir AUTOMATION.md, sous-projet 4b) : categories Torznab pour le filtre genre, bareme de taille de piece torrent, codes de langue MediaInfo reconnus, delai minimal entre requetes, nom d'affichage.",
      "properties": {
        "display_name": { "type": "string" },
        "torznab_categories": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "audio_language_codes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "min_request_interval_seconds": { "type": "number" },
        "torrent_piece_sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "max_bytes": { "type": "integer" },
              "piece_size": { "type": "integer" }
            },
            "required": ["piece_size"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "requires_field": { "type": "string" },
        "doc": { "type": "string" },
        "example": { "type": "string" },
        "forbid_spaces": { "type": "boolean" },
        "forbid_non_ascii": { "type": "boolean" },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" }
        },
        "require_one_of_groups": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "filename_template": { "type": "string" },
        "cross_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/cross_check" }
        },
        "upscale_checks": { "$ref": "#/$defs/upscale_checks" },
        "track_language_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/track_language_check" }
        },
        "source_marker_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_marker_check" }
        },
        "name_proposal": { "$ref": "#/$defs/name_proposal" }
      },
      "additionalProperties": false
    },
    "name_proposal": {
      "type": "object",
      "description": "Proposition de release_name a partir des noms de fichiers (categorie video uniquement, cf. nfogen/name_proposal.py). Placeholders disponibles dans 'template' : {title} {identifier} {language} {resolution} {video_codec} {audio} {source} {team}.",
      "properties": {
        "template": { "type": "string" },
        "language_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "source_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "video_codec_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "audio_codec_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "upscale_checks": {
      "type": "object",
      "description": "Heuristique bits-par-pixel (bitrate / (largeur x hauteur x framerate)) : avertit quand le debit reel est anormalement bas pour le codec annonce dans le release_name, indice d'upscale. Jamais bloquant ; seuils ajustables par profil sans toucher au code (nfogen/rules.py:upscale_warnings).",
      "properties": {
        "resolution_capture": { "type": "string" },
        "video_codec_capture": { "type": "string" },
        "min_bits_per_pixel": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "source_marker_check": {
      "type": "object",
      "description": "Avertit quand une source (ex. BluRay, capturee par un token nomme 'source') a un debit reel sous le seuil attendu par le tracker pour cette source, sans le marqueur de qualite correspondant deja present dans le nom (ex. 'HDLight'). Jamais bloquant (nfogen/rules.py:source_marker_warnings).",
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" } },
        "max_bit_rate_kbps": { "type": "number" },
        "marker": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["sources", "max_bit_rate_kbps", "marker", "message"],
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "pattern": { "type": "string" },
        "level": { "type": "string", "enum": ["required", "recommended"] },
        "group": { "type": "string" },
        "error": { "type": "string" },
        "warning": { "type": "string" }
      },
      "required": ["name", "pattern"],
      "additionalProperties": false
    },
    "cross_check": {
      "type": "object",
      "properties": {
        "capture": { "type": "string" },
        "metadata_field": { "type": "string" },
        "comparator": { "type": "string", "enum": ["int_equals", "codec_alias"] },
        "message": { "type": "string" },
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      },
      "required": ["capture", "metadata_field", "comparator", "message"],
      "additionalProperties": false
    },
    "track_language_check": {
      "type": "object",
      "properties": {
        "metadata_field": { "type": "string" },
        "label": { "type": "string" },
        "hint_capture": { "type": "string" },
        "warn_if_empty": { "type": "string" }
      },
      "required": ["metadata_field", "label"],
      "additionalProperties": false
    }
  }
}
