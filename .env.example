# Copier en `.env` (ignore par git) et remplir. Ne jamais commit `.env`.

# --- GapScan : fichier de config modifiable a chaud (PUT /gapscan/config,
# page "Scan" du frontend) -- URLs/cles Sonarr/Radarr (globales) et
# identifiants de tracker (namespaces par profil, voir AUTOMATION.md
# sous-projet 4b) stockees ici plutot que dans les variables ci-dessous,
# sans redemarrer le service. En son absence, repli sur ces variables
# (lecture seule, pas de PUT possible). Chemin hors du depot recommande
# (jamais commit).
NFOGEN_GAPSCAN_CONFIG_FILE=

# --- GapScan : cle API C411 (visible une seule fois a sa creation cote C411) ---
# Repli si NFOGEN_GAPSCAN_CONFIG_FILE est absent ou ne contient pas ce champ.
# Ces variables NFOGEN_C411_* ne s'appliquent QU'au profil "c411" (le seul
# qui existait avant le namespacage des identifiants par profil) -- un
# eventuel autre profil se configure uniquement via NFOGEN_GAPSCAN_CONFIG_FILE.
NFOGEN_C411_API_KEY=
NFOGEN_C411_BASE_URL=https://c411.org
# Pause minimale (secondes) entre deux requetes vers l'API C411 pendant un
# scan -- 15 requetes/min confirmees directement par les admins C411
# (2026-08-27). 4.5 par defaut (~13,3/min), marge de securite.
NFOGEN_C411_MIN_INTERVAL_SECONDS=4.5

# --- GapScan : Sonarr / Radarr (memes repli que NFOGEN_C411_API_KEY) ---
NFOGEN_SONARR_URL=
NFOGEN_SONARR_API_KEY=
NFOGEN_RADARR_URL=
NFOGEN_RADARR_API_KEY=

# --- GapScan : dernier scan termine persiste sur disque (survit a un
# redemarrage du service) -- meme principe que NFOGEN_GAPSCAN_CONFIG_FILE.
# Chemin hors du depot recommande (jamais commit).
NFOGEN_GAPSCAN_RESULTS_FILE=

# --- GapScan : au-dela de cet age (jours), un titre "deja couvert" est
# reverifie meme en mode scan rapide/incremental -- C411 retire/ajoute des
# torrents assez souvent. 7 par defaut.
NFOGEN_GAPSCAN_INCREMENTAL_MAX_AGE_DAYS=7
